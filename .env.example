# Biomni-Lite optional settings.
#
# You do not need this file to use the app. Add your model in the app instead:
# open Settings, then Models, and either log in to ChatGPT or add an API key
# for an OpenAI-compatible provider such as OpenRouter (https://openrouter.ai).
#
# Keys entered in the app are stored only on your computer, in ui_data/.
# Only use this file if you prefer to set values from the environment.
# Leave a line commented out to keep that setting unset.

# OpenAI-compatible endpoint and key, used as the default provider.
# BIOMNI_CUSTOM_BASE_URL=https://openrouter.ai/api/v1
# BIOMNI_CUSTOM_API_KEY=

# Anthropic key, only if you want to use a Claude model directly.
# ANTHROPIC_API_KEY=

# Timeout for one task, in seconds (default 600).
# BIOMNI_TIMEOUT_SECONDS=600

# Behind a VPN or corporate network with SSL inspection, point to your CA bundle.
# SSL_CERT_FILE=/path/to/ca-bundle.crt
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.crt
